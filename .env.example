# Copy this file to .env for local development.
# Never commit .env or share its values.
APP_NAME=SafeHER Digital Abuse Intelligence Platform
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Local development database. Use managed PostgreSQL for production.
DATABASE_URL=sqlite:///./safeher_dev.db

# Blank JWT_SECRET_KEY is allowed only in development and test, where an ephemeral process-local secret is generated.
# Staging and production require an explicitly configured, non-placeholder secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAX_UPLOAD_SIZE_MB=50
MAX_CONCURRENT_UPLOADS=10
CONTAINER_MAX_CONCURRENT_ANALYSES=2
WORKER_MAX_CONCURRENT_ANALYSES=1
IMAGE_TMPFS_LIMIT_MB=512
PRIVATE_STORAGE_PATH=private_evidence

AI_ENABLE_TOXIC_BERT=false
AI_DEVICE=cpu
AI_MAX_INPUT_LENGTH=10000
AI_MODEL_PATH=

# Keep neural inference disabled until properly trained, rights-cleared,
# provenance-documented, independently evaluated model artifacts are supplied.
AI_ENABLE_NEURAL_DETECTOR=false
AI_NEURAL_MODEL_A_PATH=
AI_NEURAL_MODEL_B_PATH=
AI_NEURAL_MODEL_A_SHA256=
AI_NEURAL_MODEL_B_SHA256=
AI_NEURAL_EXPECTED_VERSION_A=1.0.0
AI_NEURAL_EXPECTED_VERSION_B=1.0.0
AI_NEURAL_INFERENCE_TIMEOUT_SECONDS=5.0
AI_NEURAL_MAX_BATCH_SIZE=1
AI_NEURAL_ALLOWED_ARTIFACT_DIRS=["ai_core/neural/artifacts","models/checkpoints"]
